# Einstellungen für post_daily.sh.
# Kopieren nach post_daily.conf (steht in .gitignore, enthält Zugangsdaten).

# Welche Station und welche Grafik täglich veröffentlicht werden soll.
STATION=4931
# Mehrere durch Leerzeichen getrennt – dann entsteht je Variante ein Beitrag.
# serie | nyt-jahr | nyt-quartal | nyt-3monate | drei-tage
VARIANTE="serie drei-tage"

# --- Bild öffentlich ablegen ------------------------------------------------
# Die Instagram-API lädt keine Datei hoch, sie holt sie von einer URL.
# {src}  = lokaler Pfad zum JPEG
# {name} = Dateiname, unter dem es öffentlich liegen soll

# Variante A: eigener Webspace per scp
# WG_UPLOAD_CMD='scp {src} web:/var/www/wetter/{name}'
# WG_PUBLIC_URL='https://example.org/wetter/{name}'

# Variante B: GitHub Pages – ein eigenes öffentliches Repository für die Bilder.
# Der Commit wird übersprungen, wenn sich am Bild nichts geändert hat, sonst
# bricht git mit "nothing to commit" ab und reißt den Lauf mit.
# BILDER=~/Programming/wettergeschichtebilder
# WG_UPLOAD_CMD='cp {src} '"$BILDER"'/{name} && git -C '"$BILDER"' add -A && { git -C '"$BILDER"' diff --cached --quiet || git -C '"$BILDER"' commit -q -m "{name}"; } && git -C '"$BILDER"' push -q'
# WG_PUBLIC_URL='https://BENUTZERNAME.github.io/wettergeschichtebilder/{name}'

# Variante C: S3-kompatibler Speicher (Cloudflare R2, Backblaze B2, AWS)
# WG_UPLOAD_CMD='aws s3 cp {src} s3://wettergeschichte/{name} --acl public-read'
# WG_PUBLIC_URL='https://wettergeschichte.s3.amazonaws.com/{name}'

# --- Instagram --------------------------------------------------------------
# Numerische Instagram-User-ID des Profi-Kontos (nicht der @-Name)
# export IG_USER_ID=17841400000000000
# Langlebiges Zugriffstoken, 60 Tage gültig
# export IG_ACCESS_TOKEN=EAAG...
